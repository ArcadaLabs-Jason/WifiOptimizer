#!/bin/bash
# WiFi Optimizer - NM Dispatcher Script
# Auto-generated by WiFi Optimizer Decky plugin. Do not edit.

# Runs as root: tools are found on a fixed PATH, never an inherited one.
export PATH=/usr/bin:/bin:/usr/sbin:/sbin

SETTINGS_FILE=__SETTINGS_PATH__
PLUGIN_DIR=__PLUGIN_DIR__
LOG_TAG="wifi-optimizer"
# The name Decky knows the plugin by (plugin.json), and Decky's own settings,
# which sit beside the plugin's settings folder.
PLUGIN_NAME="WiFi Optimizer"
LOADER_SETTINGS="${SETTINGS_FILE%/*/*}/loader.json"
SYS_NET=/sys/class/net

# Only fire on interface up
[ "$2" != "up" ] && exit 0

# Only fire for wifi interfaces
IFACE_TYPE=$(/usr/bin/nmcli -t -f DEVICE,TYPE dev status 2>/dev/null | grep "^${1}:" | cut -d: -f2)
[ "$IFACE_TYPE" != "wifi" ] && exit 0

IFACE="$1"
APPLIED=0

# Self-removal: if plugin directory gone, clean up. An install or update
# swaps the directory out and back in, so look again after a moment before
# deciding it is really gone. The backend setting is left alone: our switch
# disabled the other backend, and removing the file without turning that one
# back on would leave no WiFi at the next boot.
if [ ! -d "$PLUGIN_DIR" ]; then
    sleep 3
    [ -d "$PLUGIN_DIR" ] && exit 0
    logger -t "$LOG_TAG" "Plugin directory gone, removing dispatcher"
    rm -f "$0"
    rm -f /etc/NetworkManager/conf.d/99-wifi-optimizer.conf
    rm -f /etc/modprobe.d/99-wifi-optimizer.conf
    # A report waiting to be sent, and the wake notice's record of the
    # wake it last showed: nothing is left to send them or read them.
    rm -rf /var/lib/wifi-optimizer
    exit 0
fi

# Without python3 the settings cannot be read at all, and the fallbacks below
# would change power save whatever the user chose. Do nothing instead.
if ! command -v python3 >/dev/null 2>&1; then
    logger -t "$LOG_TAG" "python3 not found, settings unreadable, nothing applied"
    exit 0
fi

# One at a time with the plugin, which holds the same lock while it saves a
# setting off and then takes that fix off: a connect in between read the old
# setting and put the fix back. Held until this script exits. With no flock,
# or still busy after ten seconds, carry on as before. The file is root's
# alone (0600): anyone who could open it could hold it, and every connect
# would wait out the ten seconds. One left 0644 by an older version is
# tightened.
LOCK_UMASK=$(umask)
if command -v flock >/dev/null 2>&1 && mkdir -p -m 0755 /run/wifi-optimizer/ 2>/dev/null \
        && { umask 077; exec 8>>/run/wifi-optimizer/apply.lock; } 2>/dev/null; then
    umask "$LOCK_UMASK"
    chmod 600 /run/wifi-optimizer/apply.lock 2>/dev/null
    flock -w 10 8 || logger -t "$LOG_TAG" "the plugin held the apply lock for 10 s, going ahead"
    # Uninstalling takes the same lock and removes this script under it. A
    # run that waited for it is from before: the fixes are being taken off,
    # and putting them back now would leave them on until a reboot.
    if [ ! -f "$0" ]; then
        logger -t "$LOG_TAG" "the plugin was uninstalled while this connect waited, nothing applied"
        exit 0
    fi
fi
umask "$LOCK_UMASK"
# iw, ip and tc below run through netlink(): in the background with the lock's
# descriptor closed, and waited for 5 s at most. One stuck in a wedged driver
# would otherwise keep this script, the apply lock and NetworkManager's queue
# of dispatcher runs waiting on it for up to NetworkManager's own limit.

# Read all settings in a single Python call for speed (<50ms).
#
# This script runs as root, and the settings file lives in a directory the
# desktop user can write to. Never `eval` anything derived from it: that would
# turn any value into a root shell command, and it would only take one future
# setting being added without sanitising for that to become a local privilege
# escalation. Read the values as plain data, then accept only known-good ones.
if [ -f "$SETTINGS_FILE" ] && [ -r "$SETTINGS_FILE" ]; then
    # The path is passed as an argument rather than pasted into the program
    # text, so a directory name containing a quote cannot alter what runs. The
    # read is capped so a large file cannot stall every WiFi connect, does not
    # follow a link or block on a FIFO planted at the name, and takes only a
    # regular file. -I keeps Python from importing anything from the
    # environment or the current directory.
    SETTINGS_RAW=$(python3 -I -c '
import json, os, sys
try:
    fd = os.open(sys.argv[1], os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
    with os.fdopen(fd, "rb") as fh:
        if (os.fstat(fh.fileno()).st_mode & 0o170000) != 0o100000:
            raise ValueError("not a regular file")
        raw = fh.read(65536)
    d = json.loads(raw)
    # Only a real JSON true turns something on: a string "false" is truthy.
    # Except power save off, which is on unless it is a real false: a value
    # of the wrong type reads as the default, as the plugin reads it.
    ps = d.get("power_save_disabled", True)
    print("False" if ps is False else "True")
    print("True" if d.get("buffer_tuning_enabled") is True else "False")
    print(str(d.get("driver", "unknown")).replace("\n", " ")[:64])
    print("True" if d.get("cake_enabled") is True else "False")
    print("True" if d.get("streaming_mode_enabled") is True else "False")
except Exception:
    print("True"); print("False"); print("unknown"); print("False"); print("False")
' "$SETTINGS_FILE" 2>/dev/null)
    {
        read -r POWER_SAVE
        read -r BUFFER_TUNING
        read -r DRIVER
        read -r CAKE
        read -r STREAM_MODE
    } <<EOF
$SETTINGS_RAW
EOF
    # Whitelist every value. Anything unexpected falls back to a safe default.
    case "$POWER_SAVE" in True|False) ;; *) POWER_SAVE="True" ;; esac
    case "$BUFFER_TUNING" in True|False) ;; *) BUFFER_TUNING="False" ;; esac
    case "$CAKE" in True|False) ;; *) CAKE="False" ;; esac
    # Unreadable means not in auto mode: the fixes then apply as always,
    # which costs some battery rather than a stream's stability.
    case "$STREAM_MODE" in True|False) ;; *) STREAM_MODE="False" ;; esac
    case "$DRIVER" in rtw88|rtw89|ath11k_pci|ath12k|mt7921e|iwlwifi) ;; *) DRIVER="unknown" ;; esac
else
    POWER_SAVE="True"
    BUFFER_TUNING="False"
    DRIVER="unknown"
    CAKE="False"
    STREAM_MODE="False"
    logger -t "$LOG_TAG" "Settings missing, safe defaults only"
fi

# Guard: if python3 failed or produced no output, fall back to safe defaults
if [ -z "$POWER_SAVE" ]; then
    POWER_SAVE="True"
    BUFFER_TUNING="False"
    DRIVER="unknown"
    CAKE="False"
    STREAM_MODE="False"
    logger -t "$LOG_TAG" "Settings parse failed, safe defaults only"
fi

# Disabled in Decky (Settings > Plugins): Decky stops the plugin but leaves
# this script in place, and reapplying everything at each connect under a
# plugin that reads as off made disabling it prove nothing. Decky's file is
# read as data, under the same rules as the settings above (no link at the
# name, no FIFO, a regular file, capped), and anything unreadable counts as
# not disabled, which is how this behaved before.
plugin_disabled() {
    python3 -I - "$LOADER_SETTINGS" "$PLUGIN_NAME" 2>/dev/null <<'DISABLEDEOF'
import json, os, sys
try:
    fd = os.open(sys.argv[1], os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
    with os.fdopen(fd, "rb") as fh:
        if (os.fstat(fh.fileno()).st_mode & 0o170000) != 0o100000:
            raise ValueError("not a regular file")
        raw = fh.read(262144)
    names = json.loads(raw).get("disabled_plugins", [])
    print("yes" if isinstance(names, list) and sys.argv[2] in names else "no")
except Exception:
    print("no")
DISABLEDEOF
}
if [ "$(plugin_disabled)" = "yes" ]; then
    logger -t "$LOG_TAG" "plugin disabled in Decky, nothing applied"
    exit 0
fi

# Whether $IFACE is the card the settings' driver drives: a PCI device whose
# module is that driver or a variant of it (rtw88_8822ce is rtw88). A second
# radio coming up, a USB adapter, is not the card the driver fixes and the
# PCIe baseline are about, even one of the same family (rtw88_8821cu).
iface_module() {
    m=$(readlink -f "$SYS_NET/$1/device/driver/module" 2>/dev/null)
    printf '%s' "${m##*/}"
}
iface_bus() {
    b=$(readlink -f "$SYS_NET/$1/device/subsystem" 2>/dev/null)
    printf '%s' "${b##*/}"
}
OUR_CARD=0
if [ "$(iface_bus "$IFACE")" = "pci" ]; then
    case "$(iface_module "$IFACE")" in
        "$DRIVER"*) OUR_CARD=1 ;;
    esac
    # With no driver profile there is nothing to tell the cards apart by,
    # and the PCIe writes go to whichever came up, as long as it is on PCI.
    [ "$DRIVER" = "unknown" ] && OUR_CARD=1
fi

# Driver-specific sysfs fixes, as in the plugin's DRIVER_PROFILES.
DRIVER_PARAMS=""
if [ "$DRIVER" = "rtw88" ]; then
    DRIVER_PARAMS="/sys/module/rtw88_core/parameters/disable_lps_deep /sys/module/rtw88_pci/parameters/disable_aspm"
elif [ "$DRIVER" = "rtw89" ]; then
    DRIVER_PARAMS="/sys/module/rtw89_pci/parameters/disable_aspm_l1 /sys/module/rtw89_pci/parameters/disable_aspm_l1ss"
elif [ "$DRIVER" = "mt7921e" ]; then
    DRIVER_PARAMS="/sys/module/mt7921e/parameters/disable_aspm"
fi
[ "$OUR_CARD" = 1 ] || DRIVER_PARAMS=""

# The driver parameters as they read now, " name=value" each.
params_now() {
    for p in $DRIVER_PARAMS; do
        printf ' %s=%s' "${p##*/}" "$(cat "$p" 2>/dev/null || echo missing)"
    done
}
# Whether this run is the one to log the parameters "at load": what the
# driver loaded with, which is whether the fixes were in force for the whole
# boot. When WiFi does not come back after sleep, the report is read after
# the reboot that fixed it, and this line is how it says so. Whichever of
# this script and the plugin is about to write a parameter first creates
# the marker and logs it, once a boot. last_enforced with no marker was
# written by a version from before the marker, so the values are ours then.
claim_at_load() {
    mkdir -p -m 0755 /run/wifi-optimizer/ 2>/dev/null
    ( set -C; : > /run/wifi-optimizer/at-load-logged ) 2>/dev/null \
        && [ ! -e /run/wifi-optimizer/last_enforced ]
}
log_at_load() {
    [ -n "$DRIVER_PARAMS" ] && claim_at_load \
        && logger -t "$LOG_TAG" "driver parameters at load:$(params_now)"
}

# Runs one netlink command (iw, ip, tc) in the background with the apply
# lock's descriptor closed and its output nowhere, and waits for it 5 s at
# most. One still running then is stuck in the driver: it is left behind,
# NETLINK_STUCK=1 skips every later one, and this run goes on with the sysfs
# writes. Its exit status otherwise. Called with no redirection of its own:
# bash keeps a copy of a descriptor it redirects around a function call, and
# a command started inside inherits that copy, the lock's included.
netlink() {
    [ "$NETLINK_STUCK" = 1 ] && return 1
    "$@" </dev/null >/dev/null 2>&1 8>&- &
    nl_pid=$!
    nl_waited=0
    while kill -0 "$nl_pid" 2>/dev/null; do
        if [ "$nl_waited" -ge 50 ]; then
            NETLINK_STUCK=1
            logger -t "$LOG_TAG" "$1 did not finish within 5 s on $IFACE, so iw, ip and tc are left out this time"
            return 1
        fi
        sleep 0.1
        nl_waited=$((nl_waited + 1))
    done
    wait "$nl_pid"
}

# The first run of a boot that nothing of ours ran before: no PCIe baseline
# yet, and no last_enforced either. A dispatcher from 0.24.3 or older wrote its
# values and last_enforced without a baseline, and the plugin writes
# last_enforced when it applies at startup, so with that file present the
# values here are ours, not the system's, and are not recorded as the system's.
# A second radio's run writes no last_enforced (see the end), so it cannot
# take the card's first run from it.
FIRST_RUN=0
if [ ! -e /run/wifi-optimizer/pcie-baseline ] && [ ! -e /run/wifi-optimizer/last_enforced ]; then
    FIRST_RUN=1
fi

# Streaming auto mode: these fixes are only for while a stream runs, which
# the plugin marks with a file in /run. Without it, leave them off.
if [ "$STREAM_MODE" = "True" ] && [ ! -f /run/wifi-optimizer/streaming ]; then
    log_at_load
    logger -t "$LOG_TAG" "streaming auto mode: no stream running, fixes left off"
    exit 0
fi

# A WiFi driver that wedged on a bad wake leaves iw stuck in the kernel for
# good, and every iw, ip or tc started for it after that joins it, holding
# this connect, and NetworkManager's queue of dispatcher runs behind it. One
# of the plugin's own netlink commands (or this script's), run by root, still
# running after several seconds is that, not a slow command (the plugin's own
# give up within five): iw for this interface, iw reg or iw phy, tc qdisc and
# ip link set. Only root's, since anyone can start a process with any name;
# never iw event or ip monitor, which run for good on purpose. The sysfs
# writes below do not go through the driver's netlink path, so they still
# run. A pgrep too old to know -O fails, which reads as nothing stuck.
NETLINK_STUCK=0
if pgrep -u 0 -O 8 -f "^([^ ]*/)?(iw (dev $IFACE( |\$)|reg |phy[^ ]* )|tc qdisc |ip link set )" \
        >/dev/null 2>&1 8>&-; then
    NETLINK_STUCK=1
    logger -t "$LOG_TAG" "an earlier iw, ip or tc is still stuck, so iw, ip and tc are left out this time"
fi

# Apply power save
if [ "$POWER_SAVE" = "True" ]; then
    # What took and what did not, so the log and last_enforced say only what
    # really happened: every write here is silent on failure.
    TOOK=0
    FAILED=0
    # Whether power save is now off on the radio, from iw itself.
    PS_OFF=0
    if [ "$NETLINK_STUCK" = 1 ]; then
        :
    elif netlink iw dev "$IFACE" set power_save off; then
        TOOK=$((TOOK + 1))
        PS_OFF=1
    else
        FAILED=$((FAILED + 1))
    fi
    WIFI_PCI=$(readlink -f "$SYS_NET/$IFACE/device" 2>/dev/null)
    # Another radio's device is not the one the plugin manages and
    # restores, so its files are left alone (no path, nothing below matches).
    [ "$OUR_CARD" = 1 ] || WIFI_PCI=""
    # What they held before this write, in the journal: "at load" from the
    # run that claims it (see claim_at_load), later lines read Y because
    # this script wrote it.
    if [ -n "$DRIVER_PARAMS" ]; then
        BEFORE=$(params_now)
        if claim_at_load; then
            logger -t "$LOG_TAG" "driver parameters at load:$BEFORE"
        else
            logger -t "$LOG_TAG" "driver parameters before applying:$BEFORE"
        fi
    fi
    # This runs at boot before the plugin loads, so the plugin only ever
    # saw our own values. Note what the system had, once per boot and
    # before the first write, so turning this off puts that back rather
    # than a guess. Same file and format the plugin reads. Only for the
    # radio the plugin manages: another one's values would stand in for it.
    if [ "$FIRST_RUN" = 1 ] && [ "$OUR_CARD" = 1 ]; then
        python3 -I - "$WIFI_PCI" $DRIVER_PARAMS <<'PYEOF' 2>/dev/null
import json, os, sys
dev, params = sys.argv[1], sys.argv[2:]
base = {}
if dev.startswith("/sys/") and os.path.isdir(dev):
    names = ["link/" + n for n in ("l0s_aspm", "l1_aspm", "l1_1_aspm", "l1_2_aspm",
                                   "l1_1_pcipm", "l1_2_pcipm")] + ["power/control"]
    for name in names:
        path = os.path.join(dev, name)
        try:
            with open(path) as f:
                base[path] = f.read(16).strip()
        except OSError:
            pass
# A parameter our own modprobe file gave the driver when it loaded holds our
# value, not the system's. Left out, so the plugin works that one out from
# the system's own configuration instead.
ours = ""
try:
    with open("/proc/stat") as f:
        boot = next(int(line.split()[1]) for line in f if line.startswith("btime "))
    conf = "/etc/modprobe.d/99-wifi-optimizer.conf"
    if os.stat(conf).st_mtime < boot:
        with open(conf) as f:
            ours = f.read(65536)
except Exception:
    pass
for path in params:
    parts = path.split("/")
    if len(parts) != 6:
        continue
    module, param = parts[3], parts[5]
    if any(line.split()[:2] == ["options", module]
           and any(word.split("=")[0] == param for word in line.split()[2:])
           for line in ours.splitlines()):
        continue
    try:
        with open(path) as f:
            base[path] = f.read(16).strip()
    except OSError:
        pass
os.makedirs("/run/wifi-optimizer", mode=0o755, exist_ok=True)
fd = os.open("/run/wifi-optimizer/pcie-baseline",
             os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
with os.fdopen(fd, "w") as f:
    json.dump(base, f)
PYEOF
    fi
    for p in $DRIVER_PARAMS; do
        [ -e "$p" ] || continue
        # rtw88 reads disable_aspm each time the PCIe link changes power
        # state, and a Y written while the chip sits in its own power save
        # (LPS) leaves ASPM stuck on. So, as the plugin does
        # (ASSOCIATED_ONLY_PARAMS), only once iw turned power save off and
        # only while associated. The other parameters are read at probe or
        # at the next start of the interface, and are written regardless.
        case "$p" in
            */rtw88_pci/parameters/disable_aspm)
                if [ "$PS_OFF" != 1 ]; then
                    logger -t "$LOG_TAG" "power save not confirmed off: disable_aspm left for the next connect"
                    continue
                fi
                if [ "$(cat "$SYS_NET/$IFACE/operstate" 2>/dev/null)" != "up" ]; then
                    logger -t "$LOG_TAG" "$IFACE is not associated: disable_aspm left for the next connect"
                    continue
                fi
                ;;
        esac
        if echo Y 2>/dev/null > "$p"; then
            TOOK=$((TOOK + 1))
        else
            FAILED=$((FAILED + 1))
        fi
    done
    # Disable PCIe ASPM for WiFi device (all drivers)
    if [ -d "$WIFI_PCI/link" ]; then
        for f in l0s_aspm l1_aspm l1_1_aspm l1_2_aspm l1_1_pcipm l1_2_pcipm; do
            # Not every device has every file (the OLED has no l0s_aspm).
            [ -e "$WIFI_PCI/link/$f" ] || continue
            if echo 0 2>/dev/null > "$WIFI_PCI/link/$f"; then
                TOOK=$((TOOK + 1))
            else
                FAILED=$((FAILED + 1))
            fi
        done
    fi
    # Runtime power management is the device's own, with or without a link
    # directory for ASPM, as in the plugin.
    if [ -f "$WIFI_PCI/power/control" ]; then
        if echo on 2>/dev/null > "$WIFI_PCI/power/control"; then
            TOOK=$((TOOK + 1))
        else
            FAILED=$((FAILED + 1))
        fi
    fi
    if [ "$TOOK" -gt 0 ]; then
        APPLIED=1
        if [ "$FAILED" -gt 0 ]; then
            logger -t "$LOG_TAG" "power_save off applied to $IFACE (driver=$DRIVER), $FAILED writes refused"
        else
            logger -t "$LOG_TAG" "power_save off applied to $IFACE (driver=$DRIVER)"
        fi
    else
        logger -t "$LOG_TAG" "power_save off: nothing took on $IFACE (driver=$DRIVER, $FAILED writes refused)"
    fi
else
    log_at_load
fi

# Apply buffer tuning
if [ "$BUFFER_TUNING" = "True" ]; then
    TOOK=0
    FAILED=0
    sysctl -w net.core.rmem_max=16777216 >/dev/null 2>&1 && TOOK=$((TOOK + 1)) || FAILED=$((FAILED + 1))
    sysctl -w net.core.wmem_max=16777216 >/dev/null 2>&1 && TOOK=$((TOOK + 1)) || FAILED=$((FAILED + 1))
    sysctl -w net.core.rmem_default=1048576 >/dev/null 2>&1 && TOOK=$((TOOK + 1)) || FAILED=$((FAILED + 1))
    sysctl -w net.core.wmem_default=1048576 >/dev/null 2>&1 && TOOK=$((TOOK + 1)) || FAILED=$((FAILED + 1))
    sysctl -w net.core.netdev_max_backlog=5000 >/dev/null 2>&1 && TOOK=$((TOOK + 1)) || FAILED=$((FAILED + 1))
    sysctl -w net.core.netdev_budget=600 >/dev/null 2>&1 && TOOK=$((TOOK + 1)) || FAILED=$((FAILED + 1))
    sysctl -w net.core.netdev_budget_usecs=8000 >/dev/null 2>&1 && TOOK=$((TOOK + 1)) || FAILED=$((FAILED + 1))
    sysctl -w net.ipv4.tcp_slow_start_after_idle=0 >/dev/null 2>&1 && TOOK=$((TOOK + 1)) || FAILED=$((FAILED + 1))
    [ "$NETLINK_STUCK" = 1 ] || netlink ip link set "$IFACE" txqueuelen 2000
    if [ "$TOOK" -gt 0 ]; then
        APPLIED=1
        if [ "$FAILED" -gt 0 ]; then
            logger -t "$LOG_TAG" "buffer tuning applied, $FAILED settings refused"
        else
            logger -t "$LOG_TAG" "buffer tuning applied"
        fi
    else
        logger -t "$LOG_TAG" "buffer tuning: nothing took ($FAILED settings refused)"
    fi
fi

# Apply CAKE QoS (unlimited: FQ + AQM + ack-filter, no bandwidth shaper)
if [ "$CAKE" = "True" ] && [ "$NETLINK_STUCK" = 1 ]; then
    logger -t "$LOG_TAG" "CAKE QoS left out on $IFACE: an earlier iw, ip or tc is stuck"
elif [ "$CAKE" = "True" ]; then
    modprobe sch_cake 2>/dev/null
    if netlink tc qdisc replace dev "$IFACE" root cake unlimited diffserv4 nat ack-filter; then
        netlink ip link set "$IFACE" txqueuelen 256
        APPLIED=1
        logger -t "$LOG_TAG" "CAKE QoS applied (unlimited) on $IFACE"
    else
        logger -t "$LOG_TAG" "CAKE QoS failed on $IFACE (sch_cake may not be available)"
    fi
fi

# Record enforcement timestamp, only when something was applied: the panel
# reads it as "reapplied on connect".
[ "$APPLIED" = 1 ] || exit 0
# Only for the card the plugin manages: a second radio's connect is not a
# reapply of the fixes the panel shows, and its stamp would make the card's
# own first run of the boot look like a later one (FIRST_RUN above).
[ "$OUR_CARD" = 1 ] || exit 0
#
# In /run, which only root can write, not in the settings directory. That one
# belongs to the desktop user, and any file root creates there can have a
# symlink swapped in between creating it and writing it, however it is done.
mkdir -p -m 0755 /run/wifi-optimizer 2>/dev/null
# The "at load" line is claimed before last_enforced is written, whatever
# this run applied: once that file is there, a later claim takes it for an
# older version's and logs nothing, and the boot has no line at all.
if claim_at_load; then
    if [ -n "$DRIVER_PARAMS" ]; then
        AT_LOAD="$(params_now)"
    else
        case "$DRIVER" in
            unknown) AT_LOAD=" not known (no driver profile)" ;;
            *) AT_LOAD=" none (the driver profile has no parameters)" ;;
        esac
    fi
    logger -t "$LOG_TAG" "driver parameters at load:$AT_LOAD"
fi
date +%s > /run/wifi-optimizer/last_enforced 2>/dev/null

exit 0
