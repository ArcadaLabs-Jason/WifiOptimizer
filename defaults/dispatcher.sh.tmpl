#!/bin/bash
# WiFi Optimizer - NM Dispatcher Script
# Auto-generated by WiFi Optimizer Decky plugin. Do not edit.

SETTINGS_FILE=__SETTINGS_PATH__
SETTINGS_DIR=$(dirname "$SETTINGS_FILE")
PLUGIN_DIR=__PLUGIN_DIR__
LOG_TAG="wifi-optimizer"

# Only fire on interface up
[ "$2" != "up" ] && exit 0

# Only fire for wifi interfaces
IFACE_TYPE=$(/usr/bin/nmcli -t -f DEVICE,TYPE dev status 2>/dev/null | grep "^${1}:" | cut -d: -f2)
[ "$IFACE_TYPE" != "wifi" ] && exit 0

IFACE="$1"

# Self-removal: if plugin directory gone, clean up
if [ ! -d "$PLUGIN_DIR" ]; then
    logger -t "$LOG_TAG" "Plugin directory gone, removing dispatcher"
    rm -f "$0"
    rm -f /etc/NetworkManager/conf.d/99-wifi-optimizer.conf
    rm -f /etc/NetworkManager/conf.d/99-wifi-optimizer-backend.conf
    rm -f /etc/modprobe.d/99-wifi-optimizer.conf
    exit 0
fi

# Read all settings in a single Python call for speed (<50ms).
#
# This script runs as root, and the settings file lives in a directory the
# desktop user can write to. Never `eval` anything derived from it: that would
# turn any value into a root shell command, and it would only take one future
# setting being added without sanitising for that to become a local privilege
# escalation. Read the values as plain data, then accept only known-good ones.
if [ -f "$SETTINGS_FILE" ] && [ -r "$SETTINGS_FILE" ]; then
    # The path is passed as an argument rather than pasted into the program
    # text, so a directory name containing a quote cannot alter what runs. The
    # read is capped so a large file cannot stall every WiFi connect.
    SETTINGS_RAW=$(python3 -c '
import json, sys
try:
    with open(sys.argv[1], "rb") as fh:
        raw = fh.read(65536)
    d = json.loads(raw)
    print("True" if d.get("power_save_disabled", True) else "False")
    print("True" if d.get("buffer_tuning_enabled", False) else "False")
    print(str(d.get("driver", "unknown")).replace("\n", " ")[:64])
    print("True" if d.get("cake_enabled", False) else "False")
except Exception:
    print("True"); print("False"); print("unknown"); print("False")
' "$SETTINGS_FILE" 2>/dev/null)
    {
        read -r POWER_SAVE
        read -r BUFFER_TUNING
        read -r DRIVER
        read -r CAKE
    } <<EOF
$SETTINGS_RAW
EOF
    # Whitelist every value. Anything unexpected falls back to a safe default.
    case "$POWER_SAVE" in True|False) ;; *) POWER_SAVE="True" ;; esac
    case "$BUFFER_TUNING" in True|False) ;; *) BUFFER_TUNING="False" ;; esac
    case "$CAKE" in True|False) ;; *) CAKE="False" ;; esac
    case "$DRIVER" in rtw88|rtw89|ath11k_pci|ath12k|mt7921e|iwlwifi) ;; *) DRIVER="unknown" ;; esac
else
    POWER_SAVE="True"
    BUFFER_TUNING="False"
    DRIVER="unknown"
    CAKE="False"
    logger -t "$LOG_TAG" "Settings missing, safe defaults only"
fi

# Guard: if python3 failed or produced no output, fall back to safe defaults
if [ -z "$POWER_SAVE" ]; then
    POWER_SAVE="True"
    BUFFER_TUNING="False"
    DRIVER="unknown"
    CAKE="False"
    logger -t "$LOG_TAG" "Settings parse failed, safe defaults only"
fi

# Apply power save
if [ "$POWER_SAVE" = "True" ]; then
    /usr/bin/iw dev "$IFACE" set power_save off 2>/dev/null
    # Driver-specific sysfs fixes
    if [ "$DRIVER" = "rtw88" ]; then
        echo Y 2>/dev/null > /sys/module/rtw88_core/parameters/disable_lps_deep
        echo Y 2>/dev/null > /sys/module/rtw88_pci/parameters/disable_aspm
    elif [ "$DRIVER" = "mt7921e" ]; then
        echo Y 2>/dev/null > /sys/module/mt7921e/parameters/disable_aspm
    fi
    # Disable PCIe ASPM for WiFi device (all drivers)
    WIFI_PCI=$(readlink -f /sys/class/net/"$IFACE"/device 2>/dev/null)
    if [ -d "$WIFI_PCI/link" ]; then
        for f in l0s_aspm l1_aspm l1_1_aspm l1_2_aspm l1_1_pcipm l1_2_pcipm; do
            echo 0 2>/dev/null > "$WIFI_PCI/link/$f"
        done
        echo on 2>/dev/null > "$WIFI_PCI/power/control"
    fi
    logger -t "$LOG_TAG" "power_save off applied to $IFACE (driver=$DRIVER)"
fi

# Apply buffer tuning
if [ "$BUFFER_TUNING" = "True" ]; then
    /usr/bin/sysctl -w net.core.rmem_max=16777216 >/dev/null 2>&1
    /usr/bin/sysctl -w net.core.wmem_max=16777216 >/dev/null 2>&1
    /usr/bin/sysctl -w net.core.rmem_default=1048576 >/dev/null 2>&1
    /usr/bin/sysctl -w net.core.wmem_default=1048576 >/dev/null 2>&1
    /usr/bin/sysctl -w net.core.netdev_max_backlog=5000 >/dev/null 2>&1
    /usr/bin/sysctl -w net.core.netdev_budget=600 >/dev/null 2>&1
    /usr/bin/sysctl -w net.core.netdev_budget_usecs=8000 >/dev/null 2>&1
    /usr/bin/sysctl -w net.ipv4.tcp_slow_start_after_idle=0 >/dev/null 2>&1
    /usr/bin/ip link set "$IFACE" txqueuelen 2000 2>/dev/null
    logger -t "$LOG_TAG" "buffer tuning applied"
fi

# Apply CAKE QoS (unlimited: FQ + AQM + ack-filter, no bandwidth shaper)
if [ "$CAKE" = "True" ]; then
    /usr/bin/modprobe sch_cake 2>/dev/null || /usr/sbin/modprobe sch_cake 2>/dev/null
    if /usr/bin/tc qdisc replace dev "$IFACE" root cake unlimited diffserv4 nat ack-filter 2>/dev/null; then
        /usr/bin/ip link set "$IFACE" txqueuelen 256 2>/dev/null
        logger -t "$LOG_TAG" "CAKE QoS applied (unlimited) on $IFACE"
    else
        logger -t "$LOG_TAG" "CAKE QoS failed on $IFACE (sch_cake may not be available)"
    fi
fi

# Record enforcement timestamp.
#
# This script runs as root and the settings directory belongs to the desktop
# user, so this name can be replaced with a link to a root-owned file that `>`
# would truncate. Checking the file first and then writing is three separate
# operations, and the user owning the directory can keep replacing it until a
# write lands between them.
#
# Write somewhere fresh and rename over the target instead. rename replaces
# whatever is at the destination rather than following it, so a link planted
# at any moment is simply overwritten, and the same holds for a hard link.
ENFORCED_FILE="$SETTINGS_DIR/last_enforced"
ENFORCED_TMP=$(mktemp "$SETTINGS_DIR/.last_enforced.XXXXXX" 2>/dev/null)
if [ -n "$ENFORCED_TMP" ]; then
    if date +%s 2>/dev/null > "$ENFORCED_TMP"; then
        # -T so a directory planted at the destination is not moved INTO;
        # that would silently stop the timestamp updating and leave a temp
        # file behind on every connect.
        mv -fT "$ENFORCED_TMP" "$ENFORCED_FILE" 2>/dev/null || rm -f "$ENFORCED_TMP"
    else
        rm -f "$ENFORCED_TMP"
    fi
fi

exit 0
