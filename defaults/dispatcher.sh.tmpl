#!/bin/bash
# WiFi Optimizer - NM Dispatcher Script
# Auto-generated by WiFi Optimizer Decky plugin. Do not edit.

# Runs as root: tools are found on a fixed PATH, never an inherited one.
export PATH=/usr/bin:/bin:/usr/sbin:/sbin

SETTINGS_FILE=__SETTINGS_PATH__
PLUGIN_DIR=__PLUGIN_DIR__
LOG_TAG="wifi-optimizer"

# Only fire on interface up
[ "$2" != "up" ] && exit 0

# Only fire for wifi interfaces
IFACE_TYPE=$(/usr/bin/nmcli -t -f DEVICE,TYPE dev status 2>/dev/null | grep "^${1}:" | cut -d: -f2)
[ "$IFACE_TYPE" != "wifi" ] && exit 0

IFACE="$1"
APPLIED=0

# Self-removal: if plugin directory gone, clean up. An install or update
# swaps the directory out and back in, so look again after a moment before
# deciding it is really gone. The backend setting is left alone: our switch
# disabled the other backend, and removing the file without turning that one
# back on would leave no WiFi at the next boot.
if [ ! -d "$PLUGIN_DIR" ]; then
    sleep 3
    [ -d "$PLUGIN_DIR" ] && exit 0
    logger -t "$LOG_TAG" "Plugin directory gone, removing dispatcher"
    rm -f "$0"
    rm -f /etc/NetworkManager/conf.d/99-wifi-optimizer.conf
    rm -f /etc/modprobe.d/99-wifi-optimizer.conf
    exit 0
fi

# Without python3 the settings cannot be read at all, and the fallbacks below
# would change power save whatever the user chose. Do nothing instead.
if ! command -v python3 >/dev/null 2>&1; then
    logger -t "$LOG_TAG" "python3 not found, settings unreadable, nothing applied"
    exit 0
fi

# Read all settings in a single Python call for speed (<50ms).
#
# This script runs as root, and the settings file lives in a directory the
# desktop user can write to. Never `eval` anything derived from it: that would
# turn any value into a root shell command, and it would only take one future
# setting being added without sanitising for that to become a local privilege
# escalation. Read the values as plain data, then accept only known-good ones.
if [ -f "$SETTINGS_FILE" ] && [ -r "$SETTINGS_FILE" ]; then
    # The path is passed as an argument rather than pasted into the program
    # text, so a directory name containing a quote cannot alter what runs. The
    # read is capped so a large file cannot stall every WiFi connect, does not
    # follow a link or block on a FIFO planted at the name, and takes only a
    # regular file. -I keeps Python from importing anything from the
    # environment or the current directory.
    SETTINGS_RAW=$(python3 -I -c '
import json, os, sys
try:
    fd = os.open(sys.argv[1], os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
    with os.fdopen(fd, "rb") as fh:
        if (os.fstat(fh.fileno()).st_mode & 0o170000) != 0o100000:
            raise ValueError("not a regular file")
        raw = fh.read(65536)
    d = json.loads(raw)
    # Only a real JSON true turns something on: a string "false" is truthy.
    print("True" if d.get("power_save_disabled", True) is True else "False")
    print("True" if d.get("buffer_tuning_enabled") is True else "False")
    print(str(d.get("driver", "unknown")).replace("\n", " ")[:64])
    print("True" if d.get("cake_enabled") is True else "False")
    print("True" if d.get("streaming_mode_enabled") is True else "False")
except Exception:
    print("True"); print("False"); print("unknown"); print("False"); print("False")
' "$SETTINGS_FILE" 2>/dev/null)
    {
        read -r POWER_SAVE
        read -r BUFFER_TUNING
        read -r DRIVER
        read -r CAKE
        read -r STREAM_MODE
    } <<EOF
$SETTINGS_RAW
EOF
    # Whitelist every value. Anything unexpected falls back to a safe default.
    case "$POWER_SAVE" in True|False) ;; *) POWER_SAVE="True" ;; esac
    case "$BUFFER_TUNING" in True|False) ;; *) BUFFER_TUNING="False" ;; esac
    case "$CAKE" in True|False) ;; *) CAKE="False" ;; esac
    # Unreadable means not in auto mode: the fixes then apply as always,
    # which costs some battery rather than a stream's stability.
    case "$STREAM_MODE" in True|False) ;; *) STREAM_MODE="False" ;; esac
    case "$DRIVER" in rtw88|rtw89|ath11k_pci|ath12k|mt7921e|iwlwifi) ;; *) DRIVER="unknown" ;; esac
else
    POWER_SAVE="True"
    BUFFER_TUNING="False"
    DRIVER="unknown"
    CAKE="False"
    STREAM_MODE="False"
    logger -t "$LOG_TAG" "Settings missing, safe defaults only"
fi

# Guard: if python3 failed or produced no output, fall back to safe defaults
if [ -z "$POWER_SAVE" ]; then
    POWER_SAVE="True"
    BUFFER_TUNING="False"
    DRIVER="unknown"
    CAKE="False"
    STREAM_MODE="False"
    logger -t "$LOG_TAG" "Settings parse failed, safe defaults only"
fi

# Streaming auto mode: these fixes are only for while a stream runs, which
# the plugin marks with a file in /run. Without it, leave them off.
if [ "$STREAM_MODE" = "True" ] && [ ! -f /run/wifi-optimizer/streaming ]; then
    logger -t "$LOG_TAG" "streaming auto mode: no stream running, fixes left off"
    exit 0
fi

# Apply power save
if [ "$POWER_SAVE" = "True" ]; then
    iw dev "$IFACE" set power_save off 2>/dev/null
    WIFI_PCI=$(readlink -f /sys/class/net/"$IFACE"/device 2>/dev/null)
    # Driver-specific sysfs fixes, as in the plugin's DRIVER_PROFILES.
    DRIVER_PARAMS=""
    if [ "$DRIVER" = "rtw88" ]; then
        DRIVER_PARAMS="/sys/module/rtw88_core/parameters/disable_lps_deep /sys/module/rtw88_pci/parameters/disable_aspm"
    elif [ "$DRIVER" = "rtw89" ]; then
        DRIVER_PARAMS="/sys/module/rtw89_pci/parameters/disable_aspm_l1 /sys/module/rtw89_pci/parameters/disable_aspm_l1ss"
    elif [ "$DRIVER" = "mt7921e" ]; then
        DRIVER_PARAMS="/sys/module/mt7921e/parameters/disable_aspm"
    fi
    # What they held before this write, in the journal. When WiFi does not
    # come back after sleep, the report is read after the reboot that fixed
    # it, and this says whether the fixes were in force during that boot.
    if [ -n "$DRIVER_PARAMS" ]; then
        BEFORE=""
        for p in $DRIVER_PARAMS; do
            BEFORE="$BEFORE ${p##*/}=$(cat "$p" 2>/dev/null || echo missing)"
        done
        logger -t "$LOG_TAG" "driver parameters before applying:$BEFORE"
    fi
    # This runs at boot before the plugin loads, so the plugin only ever
    # saw our own values. Note what the system had, once per boot and
    # before the first write, so turning this off puts that back rather
    # than a guess. Same file and format the plugin reads.
    if [ ! -e /run/wifi-optimizer/pcie-baseline ]; then
        python3 -I - "$WIFI_PCI" $DRIVER_PARAMS <<'PYEOF' 2>/dev/null
import json, os, sys
dev, params = sys.argv[1], sys.argv[2:]
base = {}
if dev.startswith("/sys/") and os.path.isdir(dev):
    names = ["link/" + n for n in ("l0s_aspm", "l1_aspm", "l1_1_aspm", "l1_2_aspm",
                                   "l1_1_pcipm", "l1_2_pcipm")] + ["power/control"]
    for name in names:
        path = os.path.join(dev, name)
        try:
            with open(path) as f:
                base[path] = f.read(16).strip()
        except OSError:
            pass
# A parameter our own modprobe file gave the driver when it loaded holds our
# value, not the system's. Left out, so the plugin works that one out from
# the system's own configuration instead.
ours = ""
try:
    with open("/proc/stat") as f:
        boot = next(int(line.split()[1]) for line in f if line.startswith("btime "))
    conf = "/etc/modprobe.d/99-wifi-optimizer.conf"
    if os.stat(conf).st_mtime < boot:
        with open(conf) as f:
            ours = f.read(65536)
except Exception:
    pass
for path in params:
    parts = path.split("/")
    if len(parts) != 6:
        continue
    module, param = parts[3], parts[5]
    if any(line.split()[:2] == ["options", module]
           and any(word.split("=")[0] == param for word in line.split()[2:])
           for line in ours.splitlines()):
        continue
    try:
        with open(path) as f:
            base[path] = f.read(16).strip()
    except OSError:
        pass
os.makedirs("/run/wifi-optimizer", mode=0o755, exist_ok=True)
fd = os.open("/run/wifi-optimizer/pcie-baseline",
             os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
with os.fdopen(fd, "w") as f:
    json.dump(base, f)
PYEOF
    fi
    for p in $DRIVER_PARAMS; do
        echo Y 2>/dev/null > "$p"
    done
    # Disable PCIe ASPM for WiFi device (all drivers)
    if [ -d "$WIFI_PCI/link" ]; then
        for f in l0s_aspm l1_aspm l1_1_aspm l1_2_aspm l1_1_pcipm l1_2_pcipm; do
            echo 0 2>/dev/null > "$WIFI_PCI/link/$f"
        done
    fi
    # Runtime power management is the device's own, with or without a link
    # directory for ASPM, as in the plugin.
    if [ -f "$WIFI_PCI/power/control" ]; then
        echo on 2>/dev/null > "$WIFI_PCI/power/control"
    fi
    APPLIED=1
    logger -t "$LOG_TAG" "power_save off applied to $IFACE (driver=$DRIVER)"
fi

# Apply buffer tuning
if [ "$BUFFER_TUNING" = "True" ]; then
    sysctl -w net.core.rmem_max=16777216 >/dev/null 2>&1
    sysctl -w net.core.wmem_max=16777216 >/dev/null 2>&1
    sysctl -w net.core.rmem_default=1048576 >/dev/null 2>&1
    sysctl -w net.core.wmem_default=1048576 >/dev/null 2>&1
    sysctl -w net.core.netdev_max_backlog=5000 >/dev/null 2>&1
    sysctl -w net.core.netdev_budget=600 >/dev/null 2>&1
    sysctl -w net.core.netdev_budget_usecs=8000 >/dev/null 2>&1
    sysctl -w net.ipv4.tcp_slow_start_after_idle=0 >/dev/null 2>&1
    ip link set "$IFACE" txqueuelen 2000 2>/dev/null
    APPLIED=1
    logger -t "$LOG_TAG" "buffer tuning applied"
fi

# Apply CAKE QoS (unlimited: FQ + AQM + ack-filter, no bandwidth shaper)
if [ "$CAKE" = "True" ]; then
    modprobe sch_cake 2>/dev/null
    if tc qdisc replace dev "$IFACE" root cake unlimited diffserv4 nat ack-filter 2>/dev/null; then
        ip link set "$IFACE" txqueuelen 256 2>/dev/null
        APPLIED=1
        logger -t "$LOG_TAG" "CAKE QoS applied (unlimited) on $IFACE"
    else
        logger -t "$LOG_TAG" "CAKE QoS failed on $IFACE (sch_cake may not be available)"
    fi
fi

# Record enforcement timestamp, only when something was applied: the panel
# reads it as "reapplied on connect".
[ "$APPLIED" = 1 ] || exit 0
#
# In /run, which only root can write, not in the settings directory. That one
# belongs to the desktop user, and any file root creates there can have a
# symlink swapped in between creating it and writing it, however it is done.
mkdir -p -m 0755 /run/wifi-optimizer 2>/dev/null
date +%s > /run/wifi-optimizer/last_enforced 2>/dev/null

exit 0
